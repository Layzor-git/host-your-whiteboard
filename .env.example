# Copy to .env and fill in. See SELF_HOSTING.md.

NODE_ENV=production

# --- Sign-in -------------------------------------------------------------
# cloudflare  Cloudflare Access in front of the app (verified JWT)
# header      your own auth proxy (Authelia, Authentik, oauth2-proxy, ...)
#             sets a header with the user's email address
# single      no sign-in, one shared user. Only for a trusted network.
AUTH_MODE=cloudflare

# AUTH_MODE=cloudflare
#   Team domain: the part before .cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=
#   Application Audience (AUD) tag of the Access application
CF_ACCESS_AUD=

# AUTH_MODE=header
#   Header carrying the email address (Authelia: Remote-Email,
#   oauth2-proxy: X-Forwarded-Email, Authentik: X-authentik-email)
# AUTH_HEADER=Remote-Email
#   Where "Sign out" leads. Empty: no sign-out button.
# LOGOUT_URL=https://auth.example.com/logout

# AUTH_MODE=single
#   All boards belong to this address.
# SINGLE_USER_EMAIL=me@localhost

# --- Port on the host (docker-compose.yml) --------------------------------
# WHITEBOARD_PORT=8080
# WHITEBOARD_BIND=127.0.0.1

# --- Never in production -------------------------------------------------
# DEV_EMAIL skips sign-in for local development. The server refuses to
# start when it is set together with NODE_ENV=production.
# DEV_EMAIL=
