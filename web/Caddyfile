:80 {
    encode zstd gzip

    # Everything under /api goes to the Node container.
    handle /api/* {
        reverse_proxy api:3000
    }

    # The rest is the built web app. try_files makes sure a path opened
    # directly gets index.html instead of a 404.
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
