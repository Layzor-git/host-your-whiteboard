# Copy to deploy.env (ignored by git) for ./deploy.sh
DEPLOY_HOST=pi@raspberrypi.local
# Folder ~/apps/<name> on the server and image name <name>-api
DEPLOY_NAME=whiteboard
# linux/arm64 for Raspberry Pi 3/4/5 with a 64-bit OS
DEPLOY_PLATFORM=linux/arm64
# Only printed at the end
DEPLOY_URL=https://whiteboard.example.com
